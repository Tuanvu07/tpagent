# Copy thành .env (cùng thư mục với docker-compose.yml) rồi điền. KHÔNG commit file .env lên GitHub.

# --- Bắt buộc ---
# Lấy tại https://console.anthropic.com -> API Keys. Gói Claude Max được tặng credit API hằng tháng.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Mật khẩu đăng nhập giao diện web. Tạo chuỗi dài ngẫu nhiên:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Để trống -> container tự tạo token và in ra log lúc khởi động.
TPAGENT_TOKEN=

# --- Tùy chọn ---
# Cổng public trên máy chủ (VPS). Trên Railway/Render/Fly nền tảng tự đặt PORT.
PORT=8080

# Chỉ dùng khi muốn rẻ hơn Claude (xem config.example.yaml để đổi tier)
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Chạy thử không cần key thật (demo giao diện):
# TPAGENT_PROVIDER=fake

# URL public để entrypoint in gợi ý đúng (vd https://tpagent.example.com)
# TPAGENT_PUBLIC_URL=
